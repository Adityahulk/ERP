# Copy to `.env` in this directory (next to `docker-compose.yml`).
# Docker Compose reads these automatically.

POSTGRES_PASSWORD=change-me-strong-password

# Host nginx + Certbot: Docker must NOT bind host port 80. Use 8080 and proxy from nginx
# (see deploy/host-nginx-docker.example.conf and deploy/nginx-microtechnique.https-full.example.conf).
FRONTEND_PORT=8080
