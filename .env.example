# Copy to `.env` in this directory (next to `docker-compose.yml`).
# Docker Compose reads these automatically.

POSTGRES_PASSWORD=change-me-strong-password

# Host nginx + Certbot: Docker must NOT bind host port 80. Use 8080 and proxy from nginx
# (see deploy/host-nginx-docker.example.conf and deploy/nginx-microtechnique.https-full.example.conf).
FRONTEND_PORT=8080

# Frontend (Vite): customer login URL used in Super Admin “Copy credentials” messages.
# Set in `frontend/.env` or your CI/build environment (not read by docker-compose from this file unless you wire it).
# VITE_APP_URL=https://app.microtechnique.in

# Optional GSTIN registry lookup provider. Use any GSTIN/taxpayer API that returns JSON.
# Put `{gstin}` in the URL where the GSTIN should be substituted, or omit it to append `/GSTIN`.
# Examples:
# GSTIN_LOOKUP_API_URL=https://your-provider.example/api/gstin/{gstin}
# GSTIN_LOOKUP_API_KEY=your-api-key
# GSTIN_LOOKUP_API_KEY_HEADER=Authorization
