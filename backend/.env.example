# Server (use 5001 on Mac if AirPlay uses 5000)
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
DATABASE_URL=postgresql://bizflow:bizflow_dev@localhost:5432/bizflow

# Redis
REDIS_URL=redis://localhost:6379

# JWT (minimum 32 characters each)
JWT_SECRET=0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SHARE_SECRET=bizflow-share-secret-change-me

# Optional: 64 hex chars for AES-256-GCM when storing GSP password in DB
# CREDENTIALS_ENCRYPTION_KEY=

# E-Invoice: mock | sandbox | production
EINVOICE_MODE=mock
# EINVOICE_USERNAME=
# EINVOICE_PASSWORD=
# EINVOICE_GSP_URL=https://your-gsp.example.com
# EINVOICE_SANDBOX_URL=https://einv-apisandbox.nic.in
# EINVOICE_PRODUCTION_URL=

# TaxPro (CharteredInfo) for e-Invoice + E-Way Bill
# TAXPRO_ENV=sandbox
# TAXPRO_API_HOST=https://gstsandbox.charteredinfo.com
# TAXPRO_ASPID=
# TAXPRO_PASSWORD=
# TAXPRO_EINV_USER_NAME=
# TAXPRO_EINV_PASSWORD=
# TAXPRO_EWB_USER_NAME=
# TAXPRO_EWB_PASSWORD=
# TAXPRO_QR_CODE_SIZE=250
# TAXPRO_EINV_AUTH_PATH=/eivital/dec/v1.04/auth
# TAXPRO_EINV_INVOICE_PATH=/eicore/dec/v1.03/Invoice
# TAXPRO_EINV_CANCEL_PATH=/eicore/dec/v1.03/Invoice/Cancel
# TAXPRO_EWB_AUTH_PATH=/ewaybillapi/dec/v1.03/auth
# TAXPRO_EWB_API_PATH=/ewaybillapi/dec/v1.03/ewayapi
# TAXPRO_EWB_GEN_ACTION=GENEWAYBILL
# TAXPRO_EWB_CANCEL_ACTION=CANEWB

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+1234567890

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Puppeteer (Docker: use /usr/bin/chromium-browser)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
