{
  "name": "microtechnique-accounts-backend",
  "version": "1.0.0",
  "description": "Microtechnique Accounts — Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && cp -R src/templates/. dist/templates/ && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "ts-node src/db/migrate.ts",
    "seed": "node dist/db/seed.js",
    "seed:dev": "ts-node src/db/seed.ts",
    "migrate:seed": "npm run migrate && npm run seed",
    "migrate:seed:dev": "npm run migrate:dev && npm run seed:dev",
    "test:smoke": "ts-node src/tests/gstService.smoke.ts",
    "test:pos": "ts-node src/tests/posWorkflow.smoke.ts",
    "reset": "ts-node src/db/reset.ts && npm run migrate:dev && npm run seed:dev"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.0",
    "@types/puppeteer": "^5.4.7",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "bwip-js": "^4.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "csv-stringify": "^6.4.5",
    "date-fns": "^3.3.1",
    "date-fns-tz": "^3.0.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.7.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "puppeteer": "^22.15.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "twilio": "^4.23.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bwip-js": "^3.2.3",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
