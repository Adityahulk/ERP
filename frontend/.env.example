# Frontend environment variables (Vite)
#
# In local dev, the API client defaults to http://127.0.0.1:5001/api
# without any of these set — they only need to be set if your backend
# runs on a different host/port than the default.

# Full override (no trailing /api — it's appended automatically).
# VITE_API_BASE_URL=http://127.0.0.1:5001

# Just the backend port, if different from the default of 5001
# (must match backend/.env's PORT).
# VITE_BACKEND_PORT=5001
